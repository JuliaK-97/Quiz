<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".QuestionsActivity"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="0dp"
        android:id="@+id/top_bar"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="5dp"
        android:padding="16dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tv_qsID"
            android:text="1/25"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_timer"
            android:text="20:15 min"
            android:textColor="#5CE763"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_weight="1"
            />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/submit_btn"
            android:text="Submit"
            android:backgroundTint="#FF7747"
            app:cornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/white"
            android:layout_weight="1"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/ll4"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#563C9D"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/qa_catName"
            android:text="Road Signs"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_weight="1"
            />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/qa_bookmarkB"
            android:src="@drawable/ic_bookmark"
            android:layout_weight="1"
            />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/question_list_gridBtn"
            android:src="@drawable/ic_right_menu"
            android:layout_weight="1"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/ll3"
        android:padding="12dp"
        android:gravity="center"
        android:background="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/prev_qs_btn"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:background="#180E2C"
            app:srcCompat="@drawable/ic_left" />



        <Button
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/mark_review_btn"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#180E2C"
            android:text="Mark for Review"
            android:textColor="@color/white"
            app:cornerRadius="20dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/next_qs_btn"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="24dp"
            android:background="#180E2C"
            app:srcCompat="@drawable/ic_right" />

    </LinearLayout>
    <FrameLayout
        android:id="@+id/question_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/ll3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll4" />
    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/mark_image"
        android:src="@drawable/mark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll4"
        android:visibility="gone"
        android:layout_marginEnd="16dp"
        android:elevation="5dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>